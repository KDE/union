{# REUSE-IgnoreEnd #}

{% macro print_css_description(description) %}
{% if description.syntax %}
@property {{ description.implicit_name }} {
    syntax: "{{ description.syntax }}";
}

{% endif %}
{% for property in description.extra_properties %}
{{- print_css_description(property) -}}
{% endfor %}
{% endmacro %}

{% macro print_properties(object) %}

{{- print_css_description(object.css) -}}

{%- for property in object.children %}
{{- print_properties(property) -}}
{% endfor -%}

{%- endmacro %}

{%- for type in types %}
{% if type.name == "style" %}
{{ print_properties(type) }}
{% endif %}
{% endfor %}
